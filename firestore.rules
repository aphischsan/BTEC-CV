rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net.
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return (isVerified() && request.auth.token.email == 'pissan282@gmail.com') ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCVSubmission(data) {
      return data.keys().hasAll(['status', 'studentName', 'studentEmail', 'cvData', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.status in ['submitted', 'reviewed'] &&
             data.studentName is string &&
             data.studentName.size() <= 200 &&
             data.studentEmail is string &&
             data.studentEmail.size() <= 200 &&
             data.cvData is string &&
             data.cvData.size() <= 50000 &&
             data.createdAt == request.time;
    }

    match /cv_submissions/{submissionId} {
      allow get, list: if isAdmin();

      // Students can submit without a login, but cannot read submissions.
      allow create: if isValidId(submissionId) &&
                       isValidCVSubmission(incoming()) &&
                       incoming().status == 'submitted';

      allow update: if isValidId(submissionId) &&
                       isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                       incoming().status in ['submitted', 'reviewed'];

      allow delete: if isAdmin();
    }
  }
}
